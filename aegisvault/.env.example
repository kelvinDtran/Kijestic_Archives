# ============================================================
# AegisVault — Environment Configuration
# Copy to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ---- Database -------------------------------------------
# PostgreSQL connection string
DATABASE_URL="postgresql://aegisvault:your_password@localhost:5432/aegisvault?schema=public"

# ---- JWT / Session Secrets ------------------------------
# Generate with: openssl rand -base64 64
# Access tokens (15 min TTL)
JWT_ACCESS_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_64"
# Refresh tokens (30 day TTL), stored hashed in DB
JWT_REFRESH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_64_DIFFERENT_FROM_ACCESS"

# ---- TOTP / WebAuthn ------------------------------------
# Your app's domain (used for WebAuthn relying party)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_DOMAIN="localhost"
APP_NAME="AegisVault"

# ---- Server-Side Encryption Key -------------------------
# Used to encrypt TOTP secrets stored in the database at rest.
# Generate with: openssl rand -base64 32
# This is a SERVER secret — do not expose to client.
SERVER_ENCRYPTION_KEY="CHANGE_ME_generate_with_openssl_rand_base64_32"

# ---- Storage (File Attachments) -------------------------
# Local storage (development)
STORAGE_PROVIDER="local"           # "local" | "s3"
LOCAL_STORAGE_PATH="./uploads"     # relative to project root

# S3-compatible storage (production)
# AWS S3, Cloudflare R2, MinIO, etc.
# S3_BUCKET_NAME="aegisvault-files"
# S3_REGION="us-east-1"
# S3_ENDPOINT=""                   # Leave empty for AWS, set for R2/MinIO
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# ---- Rate Limiting --------------------------------------
# Max login attempts per IP per 15 minutes
RATE_LIMIT_LOGIN_MAX="10"
# Max registration attempts per IP per hour
RATE_LIMIT_REGISTER_MAX="5"

# ---- Session Configuration ------------------------------
# Access token TTL in seconds (default: 15 minutes)
ACCESS_TOKEN_TTL="900"
# Refresh token TTL in seconds (default: 30 days)
REFRESH_TOKEN_TTL="2592000"
# Inactivity lock timeout in seconds (default: 5 minutes)
DEFAULT_LOCK_TIMEOUT="300"

# ---- File Upload Limits ---------------------------------
# Max file size in bytes (default: 10 MB)
MAX_FILE_SIZE="10485760"
# Max files per vault item
MAX_FILES_PER_ITEM="10"

# ---- Malware Scanning (VirusTotal) ----------------------
# Optional: enables hash-based malware scanning before file uploads.
# Files are NEVER sent to VirusTotal — only the SHA-256 hash is checked.
# Free tier: 4 requests/min, 500/day — sufficient for personal use.
# Get a free API key at: https://www.virustotal.com/gui/sign-in
# If unset, scanning is skipped and files upload without a scan verdict.
# VIRUSTOTAL_API_KEY=""

# ---- WhatsApp (Optional Recovery MFA) ------------------
# Free tier: 1,000 conversations/month via Meta Cloud API
# Setup: developers.facebook.com → Create App → WhatsApp
# Not required to run — WhatsApp recovery option is hidden if unset
# WHATSAPP_API_TOKEN="your_meta_system_user_access_token"
# WHATSAPP_PHONE_NUMBER_ID="123456789012345"

# ---- Telegram (Optional Recovery MFA) ------------------
# Free, unlimited. Create a bot at https://t.me/BotFather
# Not required to run — Telegram recovery option is hidden if unset
# TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"
# TELEGRAM_BOT_NAME="YourBotName"
# TELEGRAM_WEBHOOK_SECRET="random_32_char_string"   # optional

# ---- Resend (Optional Recovery MFA) ---------------------
# Not required to run — Email recovery option is hidden if unset
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# RESEND_FROM_EMAIL="AegisVault <noreply@yourdomain.com>"

# ---- Security -------------------------------------------
# Set to "true" in production to enforce HTTPS
FORCE_HTTPS="false"

# ---- Node Environment -----------------------------------
NODE_ENV="development"
